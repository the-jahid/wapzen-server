datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agent_tools {
  agent_id   String
  tool_id    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  agents     agents   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tools      tools    @relation(fields: [tool_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([agent_id, tool_id])
  @@index([tool_id], map: "idx_agent_tools_tool_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agents {
  id                            String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id                       String
  agent_name                    String
  language                      String               @default("en-US")
  timezone                      String?
  call_direction                String               @default("outbound")
  status                        String               @default("active")
  model_provider                String               @default("openai")
  model_name                    String               @default("gpt-4.1-mini")
  model_temperature             Float?               @default(0.3)
  prompt_begin_message_mode     String               @default("agent_speaks_first")
  prompt_begin_message          String?              @default("Hello! How can I help you today?")
  prompt_begin_message_delay_ms Int?                 @default(1000)
  prompt_system_prompt          String?              @default("You are a helpful, friendly voice assistant on a phone call. Keep responses clear and concise, speak naturally, and stay polite and professional at all times.")
  voice_provider                String?              @default("openai_realtime")
  voice_elevenlabs_voice_id     String               @default("DODLEQrClDo8wCz460ld")
  voice_elevenlabs_voice_name   String               @default("Lauren")
  voice_elevenlabs_voice_model  String               @default("eleven_turbo_v2_5")
  voice_openai_voice_id         String               @default("alloy")
  voice_openai_voice_name       String               @default("Alloy")
  voice_openai_voice_model      String               @default("tts-1")
  voice_openai_instructions     String?
  transcriber_provider          String               @default("openai")
  transcriber_language          String               @default("en")
  transcriber_openai_model      String               @default("gpt-4o-transcribe")
  transcriber_elevenlabs_model  String               @default("scribe_v2")
  post_call_analysis_provider   String               @default("openai")
  post_call_analysis_model      String?
  created_at                    DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime             @default(now()) @db.Timestamptz(6)
  phone_number_id               String?
  voice_openai_speed            Float                @default(1)
  voice_openai_volume           Float                @default(1)
  voice_openai_realtime_model   String               @default("gpt-realtime-2.1-mini")
  agent_tools                   agent_tools[]
  phone_numbers                 phone_numbers?       @relation(fields: [phone_number_id], references: [id], onUpdate: NoAction)
  users                         users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  calls                         calls[]
  knowledge_bases               knowledge_bases[]
  outbound_campaigns            outbound_campaigns[]

  @@unique([user_id, agent_name])
  @@index([user_id], map: "idx_agents_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model api_keys {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id      String
  name         String    @default("Default")
  key_hash     String    @unique
  key_prefix   String
  last_used_at DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  is_default   Boolean   @default(false)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_api_keys_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model call_messages {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  call_id    String
  seq        Int
  role       String
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  calls      calls    @relation(fields: [call_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([call_id, seq])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calls {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  call_id            String
  user_id            String
  phone_number_id    String?
  peer               String
  status             String              @default("received")
  end_reason         String?
  answered_at        DateTime?           @db.Timestamptz(6)
  ended_at           DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  call_type          String              @default("inbound")
  agent_id           String?
  duration_seconds   Int?
  campaign_id        String?
  lead_id            String?
  call_messages      call_messages[]
  agents             agents?             @relation(fields: [agent_id], references: [id], onUpdate: NoAction)
  outbound_campaigns outbound_campaigns? @relation(fields: [campaign_id], references: [id], onUpdate: NoAction)
  campaign_leads     campaign_leads?     @relation(fields: [lead_id], references: [id], onUpdate: NoAction)
  phone_numbers      phone_numbers?      @relation(fields: [phone_number_id], references: [id], onUpdate: NoAction)
  users              users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([call_id], map: "idx_calls_call_id")
  @@index([phone_number_id], map: "idx_calls_phone_number_id")
  @@index([user_id], map: "idx_calls_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model campaign_leads {
  id                 String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  campaign_id        String
  phone_number       String
  email              String?
  first_name         String?
  last_name          String?
  status             String             @default("pending")
  attempts           Int                @default(0)
  last_attempted_at  DateTime?          @db.Timestamptz(6)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  calls              calls[]
  outbound_campaigns outbound_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([campaign_id, phone_number])
  @@index([campaign_id], map: "idx_campaign_leads_campaign_id")
  @@index([campaign_id, status], map: "idx_campaign_leads_campaign_status")
}

model chat_agent_tools {
  chat_agent_id String
  tool_id       String
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  chat_agents   chat_agents @relation(fields: [chat_agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tools         tools       @relation(fields: [tool_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([chat_agent_id, tool_id])
  @@index([tool_id], map: "idx_chat_agent_tools_tool_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_agents {
  id                   String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id              String
  agent_name           String
  phone_number_id      String?              @unique
  status               String               @default("inactive")
  model_provider       String               @default("openai")
  model_name           String               @default("gpt-4.1-mini")
  model_temperature    Float                @default(0.3)
  prompt_system_prompt String               @default("You are a helpful, friendly WhatsApp chat assistant.")
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  chat_agent_tools     chat_agent_tools[]
  phone_numbers        phone_numbers?       @relation(fields: [phone_number_id], references: [id], onUpdate: NoAction)
  users                users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat_conversations   chat_conversations[]
  knowledge_bases      knowledge_bases[]

  @@unique([user_id, agent_name])
  @@index([user_id], map: "idx_chat_agents_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_conversations {
  id                String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id           String
  phone_number_id   String?
  chat_agent_id     String?
  peer_jid          String
  peer_phone        String?
  peer_name         String?
  status            String          @default("open")
  message_count     Int             @default(0)
  last_message_role String?
  last_message_at   DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)
  chat_agents       chat_agents?    @relation(fields: [chat_agent_id], references: [id], onUpdate: NoAction)
  phone_numbers     phone_numbers?  @relation(fields: [phone_number_id], references: [id], onUpdate: NoAction)
  users             users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat_messages     chat_messages[]

  @@index([user_id, last_message_at(sort: Desc)], map: "idx_chat_conversations_user_recent")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
