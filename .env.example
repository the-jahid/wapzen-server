PORT=8080
APP_ENV=development
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/wapzen?schema=public"
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
ELEVENLABS_API_KEY=elevenlabs_replace_me
OPENAI_API_KEY=openai_replace_me
OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_SILENCE_MS=250
ANTHROPIC_API_KEY=anthropic_replace_me

# Knowledge base indexing. Without PINECONE_API_KEY and PINECONE_INDEX_HOST the
# server still starts, but adding sources to a knowledge base answers 503.
# The dimension must match the index: it is requested from the embedding model
# and checked against every vector before it is written.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
PINECONE_API_KEY=pinecone_replace_me
PINECONE_INDEX_NAME=voice
PINECONE_INDEX_DIMENSION=3072
PINECONE_INDEX_HOST=https://your-index.svc.your-region.pinecone.io
